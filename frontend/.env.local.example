# Dev lokal — kosongkan agar browser pakai proxy Next.js (/api/v1 → localhost:8000)
NEXT_PUBLIC_API_URL=

# URL kanonis frontend (SEO, Open Graph, sitemap) — wajib di produksi
NEXT_PUBLIC_SITE_URL=https://sigerciv.com

# SSR Next.js & rewrite proxy
BACKEND_URL=http://localhost:8000

# Produksi (contoh subdomain API terpisah):
# NEXT_PUBLIC_API_URL=https://api.sigerciv.com
# BACKEND_URL=http://backend:8000
