# deploy/caddy/Caddyfile — reverse proxy + TLS otomatis (Let's Encrypt)
# Variabel dari container Caddy (lihat docker-compose.yml & deploy/.env)

{
	email {env.ACME_EMAIL}
	admin off
}

{env.API_DOMAIN} {
	request_body {
		max_size 25MB
	}

	# MinIO — presign PUT & GET objek dari browser (F4 media)
	handle_path /media/* {
		reverse_proxy minio:9000 {
			header_up Host {host}
		}
	}

	handle {
		reverse_proxy backend:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
}

{env.FRONTEND_DOMAIN} {
	reverse_proxy frontend:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}
