# deploy/caddy/Caddyfile — reverse proxy + TLS otomatis (Let's Encrypt)
# Variabel dari container Caddy (lihat docker-compose.yml & deploy/.env)
# Penting: alamat site pakai {$VAR} (parse-time), BUKAN {env.VAR} (runtime — tidak valid di address).

{
	email {$ACME_EMAIL}
	admin off
}

{$API_DOMAIN} {
	request_body {
		max_size 25MB
	}

	# MinIO — presign PUT & GET objek dari browser (F4 media)
	handle_path /media/* {
		reverse_proxy minio:9000 {
			header_up Host {host}
		}
	}

	handle {
		reverse_proxy backend:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
}

{$FRONTEND_DOMAIN} {
	# API same-origin — cookie refresh & Bearer refresh jalan tanpa CORS cross-site
	handle /api/v1/* {
		reverse_proxy backend:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		reverse_proxy frontend:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
}
