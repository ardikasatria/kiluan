# deploy/.env.example — salin ke deploy/.env lalu sesuaikan untuk VM produksi.
#   cp .env.example .env
# JANGAN commit file .env (sudah di .gitignore).

# ── Domain & Caddy (TLS otomatis) ─────────────────────────────
FRONTEND_DOMAIN=sigerciv.com
API_DOMAIN=api.sigerciv.com
ACME_EMAIL=admin@sainsdataciv.com

# ── Publikasi ──────────────────────────────────────────────────
APP_BASE_URL=https://sigerciv.com
NEXT_PUBLIC_API_URL=https://api.sigerciv.com
# CORS: daftar origin dipisah koma (bukan JSON array)
CORS_ORIGINS=https://sigerciv.com,http://sigerciv.com
COOKIE_SECURE=true

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=kiluan
POSTGRES_PASSWORD=ubah_sandi_kuat_di_produksi
POSTGRES_DB=kiluan

DATABASE_URL=postgresql+asyncpg://kiluan:ubah_sandi_kuat_di_produksi@db:5432/kiluan
DATABASE_URL_SYNC=postgresql+psycopg://kiluan:ubah_sandi_kuat_di_produksi@db:5432/kiluan

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO (media F0) ─────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=kiluan
MINIO_ROOT_PASSWORD=ubah_sandi_kuat_di_produksi
MINIO_BUCKET=kiluan
MINIO_PUBLIC_BASE_URL=https://api.sigerciv.com/media
MINIO_SECURE=true

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
ADMIN_EMAIL=admin@sainsdataciv.com
ADMIN_SANDI_AWAL=ubah_setelah_login_pertama

# ── Email ──────────────────────────────────────────────────────
EMAIL_PROVIDER=dev
EMAIL_FROM=sigerciv <no-reply@sigerciv.com>

# ── Cuaca BMKG ────────────────────────────────────────────────
CUACA_AKTIF=true
CUACA_CACHE_TTL_DETIK=10800
