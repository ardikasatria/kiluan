# deploy/.env.contoh — salin ke deploy/.env lalu sesuaikan untuk VM produksi.
#   cp .env.contoh .env
# JANGAN commit file .env (sudah di .gitignore).

# ── Publikasi (ganti <IP-VM> dengan IP atau domain VM Anda) ──
# Contoh VM: http://203.0.113.10
APP_BASE_URL=http://103.23.199.200
NEXT_PUBLIC_API_URL=https://kiluanapi.sainsdataciv.com
CORS_ORIGINS=["http://103.23.199.200","https://kiluan.sainsdataciv.com","http://kiluan.sainsdataciv.com"]
COOKIE_SECURE=true
# Set COOKIE_SECURE=true setelah TLS/HTTPS aktif

HTTP_PORT=8080

MINIO_PUBLIC_BASE_URL=https://kiluan.sainsdataciv.com/media
# atau URL MinIO publik terpisah
MINIO_SECURE=true   # jika HTTPS

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=kiluan
POSTGRES_PASSWORD=Kiluan345
POSTGRES_DB=kiluan

DATABASE_URL=postgresql+asyncpg://kiluan:Kiluan345@db:5432/kiluan
DATABASE_URL_SYNC=postgresql+psycopg://kiluan:Kiluan345@db:5432/kiluan

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO (media F0) ─────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=kiluan
MINIO_ROOT_PASSWORD=Kiluan123
MINIO_BUCKET=kiluan

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=dca7e4c06b46e47802603816c213e25b247752a00f46f22f167f7648a71765eb

# Admin pertama (dibuat migrasi bootstrap 0001)
ADMIN_EMAIL=admin@sainsdataciv.com
ADMIN_SANDI_AWAL=admin

# ── Email (dev = log ke container; produksi = resend_api) ────
EMAIL_PROVIDER=dev
EMAIL_FROM=Kiluan <no-reply@kiluan.sainsdataciv.com>

# ── Cuaca BMKG (B2) ───────────────────────────────────────────
CUACA_AKTIF=true
CUACA_CACHE_TTL_DETIK=10800