# deploy/.env.contoh — salin ke deploy/.env lalu sesuaikan untuk VM produksi.
#   cp .env.contoh .env
# JANGAN commit file .env (sudah di .gitignore).

# ── Domain & Caddy (TLS otomatis) ─────────────────────────────
FRONTEND_DOMAIN=sigerciv.com
API_DOMAIN=api.sigerciv.com
# Email untuk Let's Encrypt (wajib agar sertifikat terbit)
ACME_EMAIL=admin@sainsdataciv.com

# ── Publikasi ──────────────────────────────────────────────────
# Frontend (tautan email, verifikasi, reset sandi)
APP_BASE_URL=https://sigerciv.com

# Frontend origin yang boleh memanggil API (CORS + cookie refresh)
CORS_ORIGINS=https://sigerciv.com,http://sigerciv.com,http://localhost:3000

# Browser memanggil API langsung ke subdomain ini (bukan same-origin /api)
NEXT_PUBLIC_API_URL=https://api.sigerciv.com

COOKIE_SECURE=true

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=kiluan
POSTGRES_PASSWORD=Kiluan345
POSTGRES_DB=kiluan

DATABASE_URL=postgresql+asyncpg://kiluan:Kiluan345@db:5432/kiluan
DATABASE_URL_SYNC=postgresql+psycopg://kiluan:Kiluan345@db:5432/kiluan

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO (media F0) ─────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=kiluan
MINIO_ROOT_PASSWORD=Kiluan123
MINIO_BUCKET=kiluan
# URL publik objek & presign PUT dari browser (proxy /media/ di Caddy API)
MINIO_PUBLIC_BASE_URL=https://api.sigerciv.com/media
MINIO_SECURE=true

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=dca7e4c06b46e47802603816c213e25b247752a00f46f22f167f7648a71765eb

# Admin pertama (dibuat migrasi bootstrap 0001)
ADMIN_EMAIL=admin@sainsdataciv.com
ADMIN_SANDI_AWAL=admin

# ── Email (dev = log ke container; produksi = resend_api) ────
EMAIL_PROVIDER=dev
EMAIL_FROM=sigerciv <no-reply@sigerciv.com>

# ── Cuaca BMKG (B2) ───────────────────────────────────────────
CUACA_AKTIF=true
CUACA_CACHE_TTL_DETIK=10800
