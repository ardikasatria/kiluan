# deploy/.env.contoh — salin ke deploy/.env lalu sesuaikan untuk VM produksi.
#   cp .env.contoh .env
# JANGAN commit file .env (sudah di .gitignore).

# ── Domain & Caddy (TLS otomatis) ─────────────────────────────
FRONTEND_DOMAIN=kiluan.sainsdataciv.com
API_DOMAIN=kiluanapi.sainsdataciv.com
# Email untuk Let's Encrypt (wajib agar sertifikat terbit)
ACME_EMAIL=admin@sainsdataciv.com

# ── Publikasi ──────────────────────────────────────────────────
# Frontend (tautan email, verifikasi, reset sandi)
APP_BASE_URL=https://kiluan.sainsdataciv.com

# Frontend origin yang boleh memanggil API (CORS + cookie refresh)
CORS_ORIGINS=https://kiluan.sainsdataciv.com,http://kiluan.sainsdataciv.com,http://localhost:3000

# Browser memanggil API langsung ke subdomain ini (bukan same-origin /api)
NEXT_PUBLIC_API_URL=https://kiluanapi.sainsdataciv.com

COOKIE_SECURE=true

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=kiluan
POSTGRES_PASSWORD=ubah_sandi_kuat_di_produksi
POSTGRES_DB=kiluan

DATABASE_URL=postgresql+asyncpg://kiluan:ubah_sandi_kuat_di_produksi@db:5432/kiluan
DATABASE_URL_SYNC=postgresql+psycopg://kiluan:ubah_sandi_kuat_di_produksi@db:5432/kiluan

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO (media F0) ─────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=kiluan
MINIO_ROOT_PASSWORD=ubah_sandi_kuat_di_produksi
MINIO_BUCKET=kiluan
# URL publik objek & presign PUT dari browser (proxy /media/ di Caddy API)
MINIO_PUBLIC_BASE_URL=https://kiluanapi.sainsdataciv.com/media
MINIO_SECURE=true

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter

# Admin pertama (dibuat migrasi bootstrap 0001)
ADMIN_EMAIL=admin@kiluan.local
ADMIN_SANDI_AWAL=ubah_setelah_login_pertama

# ── Email (dev = log ke container; produksi = resend_api) ────
EMAIL_PROVIDER=dev
EMAIL_FROM=Kiluan <no-reply@kiluan.sainsdataciv.com>

# ── Cuaca BMKG (B2) ───────────────────────────────────────────
CUACA_AKTIF=true
CUACA_CACHE_TTL_DETIK=10800
