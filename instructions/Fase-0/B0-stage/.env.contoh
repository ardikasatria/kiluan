# Salinan referensi. Deploy aktif: deploy/.env (lihat deploy/.env.contoh di root repo)

POSTGRES_USER=kiluan
POSTGRES_PASSWORD=kiluan
POSTGRES_DB=kiluan

# App runtime (asyncpg)
DATABASE_URL=postgresql+asyncpg://kiluan:kiluan@db:5432/kiluan
# Alembic migrasi (psycopg, sinkron)
DATABASE_URL_SYNC=postgresql+psycopg://kiluan:kiluan@db:5432/kiluan

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=kiluan
MINIO_ROOT_PASSWORD=kiluanrahasia
MINIO_BUCKET=media

JWT_SECRET=ganti-dengan-secret-produksi-minimal-16-karakter
ADMIN_EMAIL=admin@kiluan.local
ADMIN_SANDI_AWAL=ubah-saya
