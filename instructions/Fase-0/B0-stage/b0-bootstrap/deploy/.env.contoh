# deploy/.env.contoh — salin ke deploy/.env dan sesuaikan.
# JANGAN commit .env berisi kredensial nyata.

# --- Postgres ---
POSTGRES_USER=kiluan
POSTGRES_PASSWORD=ubah_saya_di_produksi
POSTGRES_DB=kiluan

# URL app (async, dipakai FastAPI) & URL alembic (sync, dipakai migrasi).
# host 'db' = nama service compose.
DATABASE_URL=postgresql+asyncpg://kiluan:ubah_saya_di_produksi@db:5432/kiluan
DATABASE_URL_SYNC=postgresql+psycopg://kiluan:ubah_saya_di_produksi@db:5432/kiluan

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=kiluan
MINIO_ROOT_PASSWORD=ubah_saya_di_produksi
MINIO_BUCKET=kiluan

# --- Publikasi ---
DOMAIN=kiluanapi.sainsdataciv.com
FRONTEND_DOMAIN=kiluan.sainsdataciv.com
CORS_ORIGINS=http://localhost:3000,https://kiluan.sainsdataciv.com,http://kiluan.sainsdataciv.com

# --- Auth ---
JWT_SECRET=ganti_dengan_string_acak_panjang

# --- Seed admin pertama (dibuat migrasi bootstrap) ---
ADMIN_EMAIL=admin@kiluan.local
ADMIN_SANDI_AWAL=ubah_setelah_login_pertama
